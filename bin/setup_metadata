                     fp.write("\n")

    except IOError:
        raise UserWarning("Problem writing file" + f + "\n")


def main(inargs):
    narg = len(inargs)
    if narg != 2:
        print("Error: incorrect number of input arguments")
        print("Usage: setup_metadata <maximum number of regions> <maximum number of resolutions per region>")
        exit(1)
    maxnregn = int(inargs[0])
    maxnresln = int(inargs[1])

    confdir = os.path.split(os.getcwd())[0] + "/"
    metadir = confdir + "meta/"

    metafile = metadir + "rose-meta.conf"
    conffile = confdir + "rose-suite.conf"

    set_suite_conf(conffile, maxnregn, maxnresln)
    set_metadata(metafile, maxnregn, maxnresln)


if __name__=='__main__':
    main(sys.argv[1:])
